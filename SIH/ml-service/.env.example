# ML Service Environment Variables
# Copy to .env and fill in values

# Model serving mode: "heuristic" (default) or "trained"
MODEL_MODE=heuristic

# Optional: Path to trained models directory (when MODEL_MODE=trained)
# MODELS_DIR=./models

# Optional: External API keys for data fetching (if needed by pipeline)
# NOAA_API_KEY=
# UCSB_API_KEY=